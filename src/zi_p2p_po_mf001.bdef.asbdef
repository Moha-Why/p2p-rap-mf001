managed implementation in class ZBP_I_P2P_PO_MF001 unique;
strict ( 2 );
with draft;

define behavior for ZI_P2P_PO_MF001 alias PurchaseOrder
persistent table zp2p_po_mf001
draft table zp2p_dpo_mf001
lock master total etag LastChangedAt
authorization master ( instance )
etag master LocalLastChangedAt
{
  create;
  update ( features : instance );
  delete ( features : instance );

  field ( readonly, numbering : managed ) PurchaseOrderUUID;
  field ( readonly ) Status, CurrencyCode, TotalAmount,
                     CreatedBy, CreatedAt, LocalLastChangedBy,
                     LocalLastChangedAt, LastChangedAt;
  field ( mandatory ) PurchaseOrderNumber, SupplierID, OrderDate;

  association _Items { create ( features : instance, authorization : update ); with draft; }

  determination setDefaults on modify { create; }

  draft action ( features : instance ) Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;
  draft determine action Prepare;

  mapping for zp2p_po_mf001
  {
    PurchaseOrderUUID = po_uuid;
    PurchaseOrderNumber = po_number;
    SupplierID = supplier_id;
    OrderDate = order_date;
    CurrencyCode = currency_code;
    Status = status;
    TotalAmount = total_amount;
    CreatedBy = created_by;
    CreatedAt = created_at;
    LocalLastChangedBy = local_last_changed_by;
    LocalLastChangedAt = local_last_changed_at;
    LastChangedAt = last_changed_at;
  }
}

define behavior for ZI_P2P_POIT_MF001 alias PurchaseOrderItem
persistent table zp2p_poit_mf001
draft table zp2p_dpoit_mf001
lock dependent by _PurchaseOrder
authorization dependent by _PurchaseOrder
etag master LocalLastChangedAt
{
  update ( features : instance );
  delete ( features : instance );

  field ( readonly, numbering : managed ) PurchaseOrderItemUUID;
  field ( readonly ) PurchaseOrderUUID, UnitCode, CurrencyCode, NetAmount,
                     CreatedBy, CreatedAt, LocalLastChangedBy,
                     LocalLastChangedAt, LastChangedAt;
  field ( mandatory ) ItemNumber, ProductID, Quantity, UnitPrice;

  association _PurchaseOrder { with draft; }
  determination setDefaults on modify { create; }

  mapping for zp2p_poit_mf001
  {
    PurchaseOrderItemUUID = item_uuid;
    PurchaseOrderUUID = po_uuid;
    ItemNumber = item_number;
    ProductID = product_id;
    ItemDescription = description;
    UnitCode = unit_code;
    CurrencyCode = currency_code;
    Quantity = quantity;
    UnitPrice = unit_price;
    NetAmount = net_amount;
    CreatedBy = created_by;
    CreatedAt = created_at;
    LocalLastChangedBy = local_last_changed_by;
    LocalLastChangedAt = local_last_changed_at;
    LastChangedAt = last_changed_at;
  }
}
