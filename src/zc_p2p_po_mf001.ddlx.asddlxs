@Metadata.layer: #CORE
@UI.headerInfo: {
  typeName: 'Purchase order', typeNamePlural: 'Purchase orders',
  title: { type: #STANDARD, value: 'PurchaseOrderNumber' }
}
annotate entity ZC_P2P_PO_MF001 with
{
  @UI.facet: [
    { id: 'Order', type: #IDENTIFICATION_REFERENCE, label: 'Order',
      targetQualifier: 'General', position: 10 },
    { id: 'Items', type: #LINEITEM_REFERENCE, label: 'Items',
      targetElement: '_Items', position: 20 }
  ]
  @UI.hidden: true
  PurchaseOrderUUID;

  @EndUserText.label: 'Order number'
  @UI.lineItem: [{ position: 10, importance: #HIGH },
                 { type: #FOR_ACTION, dataAction: 'releaseOrder', label: 'Release' }]
  //Unqualified identification entries become buttons in the object page header.
  @UI.identification: [{ qualifier: 'General', position: 10 },
                       { type: #FOR_ACTION, dataAction: 'releaseOrder', label: 'Release' }]
  PurchaseOrderNumber;

  @EndUserText.label: 'Supplier'
  @UI.lineItem: [{ position: 20, importance: #HIGH }]
  @UI.identification: [{ qualifier: 'General', position: 20 }]
  @UI.selectionField: [{ position: 10 }]
  SupplierID;
  @UI.hidden: true
  SupplierName;

  @EndUserText.label: 'Order date'
  @UI.lineItem: [{ position: 30 }]
  @UI.identification: [{ qualifier: 'General', position: 30 }]
  @UI.selectionField: [{ position: 20 }]
  OrderDate;

  @EndUserText.label: 'Currency'
  @UI.identification: [{ qualifier: 'General', position: 40 }]
  CurrencyCode;

  @EndUserText.label: 'Status'
  @UI.lineItem: [{ position: 40, criticality: 'StatusCriticality' }]
  @UI.identification: [{ qualifier: 'General', position: 50, criticality: 'StatusCriticality' }]
  @UI.selectionField: [{ position: 30 }]
  @UI.textArrangement: #TEXT_ONLY
  Status;
  @UI.hidden: true
  StatusText;
  @UI.hidden: true
  StatusCriticality;

  @EndUserText.label: 'Order total'
  @UI.lineItem: [{ position: 50, importance: #HIGH }]
  @UI.identification: [{ qualifier: 'General', position: 60 }]
  TotalAmount;

  @UI.hidden: true
  CreatedBy;
  @UI.hidden: true
  CreatedAt;
  @UI.hidden: true
  LocalLastChangedBy;
  @UI.hidden: true
  LocalLastChangedAt;
  @UI.hidden: true
  LastChangedAt;
}
